  - {fileID: 11400000, guid: 8737ddebd93d042fda9e440ab65d4100, type: 2}
  paragraphs:
  - "\u22EF\u22EF."
  - "\u22EF\u22EF\uC751?"
  - "\uC5EC\uAE34 \uBB50\uC57C? \uC5B4\uB514\uC9C0? \uAFC8?!"
  - "\uC640, \uC790\uAC01\uBABD? \uADF8\uB7F0 \uAC74\uAC00?"
  - "\uB098\uB294 \uBA38\uB9AC\uCE74\uB77D\uC744 \uBF51\uC544\uBCF8\uB2E4. \uD478\uB978
    \uBA38\uB9AC\uCE74\uB77D\uC774 \uBA87 \uAC00\uB2E5 \uBF51\uD600 \uB098\uC628\uB2E4."
  - "\u22EF\u22EF\uC544\uD504\uC796\uC544! \uADF8\uB9AC\uACE0 \uC65C \uCCAD\uB85D\uC0C9\uC774\uC57C?"
  - "\uC544\uC544\u22EF\u22EF. \uB4DC\uB514\uC5B4\u22EF!"
  - "\uC800\uAC74 \uB610 \uB204\uAD6C\uACE0?"
  - "\uC6A9\uC0AC\uB2D8! \uBD80\uB984\uC5D0 \uC751\uB2F5\uD574 \uC8FC\uC168\uAD70\uC694!"
  - "\uC544\uB2C8, \uBB54\u22EF\u22EF."
  - "\uBB34\uC2A8 \uC18C\uB9AC\uC138\uC694???"
  - "\uC800\uB294 \uC2DC\uAC04\uACFC \uACF5\uAC04\uC758 \uB9C8\uBC95\uC0AC \uCC28\uB974\uB374\uC785\uB2C8\uB2E4."
  - "\uC774 \uC778\uAC04\u22EF \uB0B4 \uB9D0\uC744 \uC548 \uB4E3\uACE0 \uC788\uC796\uC544."
  - "\uB2E4 \uC124\uBA85\uB4DC\uB9B4 \uD14C\uB2C8 \uADF8\uB7F0 \uD45C\uC815 \uC9D3\uC9C0
    \uB9C8\uC138\uC694."
  - "\uC6A9\uC0AC\uB2D8\uC744 \uC774\uACF3\uC73C\uB85C \uC18C\uD658\uD55C \uAC83\uC740\u22EF
    \uC77C\uB2E8, \uC800\uC785\uB2C8\uB2E4."
  - "\uC6A9\uC0AC\uB2D8\uAED8\uC11C\uB3C4 \uC18C\uD658\uC11C\uB97C \uD3BC\uCCD0\uC8FC\uC2DC\uC9C0
    \uC54A\uC558\uB098\uC694?"
  - "\uC18C\uD658\uC11C\u22EF\u22EF \uC544, \uADF8 \uCC45\uC774\uC694?!"
  - "\uB124, \uB9DE\uC2B5\uB2C8\uB2E4. \uACE0\uB300\uC758 \uB9C8\uBC95\uC11C\uC5D0
    \uC758\uD558\uBA74, \uC18C\uD658\uC11C\uB294 \uC54C\uB9DE\uC740 \uC774\uB97C
    \uC2A4\uC2A4\uB85C \uCC3E\uC544\uAC04\uB2E4\uACE0 \uD558\uB354\uAD70\uC694."
  - "\uB9C8\uC655 \uB178\uD06C\uBAA8\uB974\uC5D0 \uC758\uD574 \uC704\uD5D8\uC5D0
    \uBE60\uC9C4 \uC774 \uC138\uACC4\uB97C \uAD6C\uD574\uC8FC\uC2E4 \uC6A9\uC0AC\uB2D8\uAED8
    \uB9D0\uC785\uB2C8\uB2E4."
  - "\uC544\uB2C8, \uC800\uB294 \uADF8\uB0E5 \uBC31\uC218\uC778\uB370\uC694?"
  - "\uD559\uAD50 \uCCB4\uB825\uC7A5\uC5D0\uC11C\uB3C4 \uB9E8\uB0A0 \uAF34\uB4F1
    \uD588\uACE0, \uC131\uC778\uC774 \uB418\uC5B4\uC11C\uB3C4 \uB9E8\uB0A0 \uAC8C\uC784\uB9CC
    \uD558\uACE0."
  - "\uC808 \uC18C\uD658\uD558\uC2E4 \uC815\uB3C4\uBA74 \uC5C4\uCCAD\uB09C \uB9C8\uBC95\uC0AC\uC2E4
    \uD150\uB370 \uC54C\uC544\uC11C \uD574\uACB0 \uBABB \uD574\uC694? \uB2E4\uB978
    \uC0AC\uB78C \uCC3E\uC73C\uC2DC\uAC70\uB098."
  - "\uC548\uD0C0\uAE5D\uAC8C\uB3C4 \uADF8\uAC74 \uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - "\uB9C8\uC655 \uB178\uD06C\uBAA8\uB974\uC640 \uC800\uC758 \uBFCC\uB9AC\uB294
    \uAC19\uC2B5\uB2C8\uB2E4. \uADF8\uC5D0\uAC8C\uB294 \uC81C \uD798\uC774 \uC804\uD600
    \uD1B5\uD558\uC9C0 \uC54A\uC544\uC694."
  - "\uADF8\uB9AC\uACE0 \uC774\uBC88\uC5D0 \uC6A9\uC0AC\uB2D8\uC744 \uC18C\uD658\uD558\uB290\uB77C
    \uC81C \uB9C8\uB098\uB97C \uC804\uBD80 \uC368\uBC84\uB838\uC2B5\uB2C8\uB2E4."
  - "\uB2E4\uB978 \uC138\uACC4\uB85C \uAC00\uB294 \uBB38\uC744 \uC5F4\uB824\uBA74
    10\uB144\uC740 \uC871\uD788\u22EF"
  - "\uC790, \uC7A0\uAE50\uB9CC. 10\uB144\uC774\uC694? \uADF8\uB7FC \uC804 \uC9D1\uC5D0
    \uC5B4\uB5BB\uAC8C \uAC00\uC694?"
  - "\uBC29\uBC95\uC740 \uD558\uB098\uC785\uB2C8\uB2E4. \uB9C8\uC655\uC758 \uC815\uC218\uC5D0
    \uB2F4\uAE34 \uB9C8\uB098\uB97C \uC774\uC6A9\uD558\uB294 \uAC83\uC774\uC9C0\uC694."
  - "\uC6A9\uC0AC\uB2D8, \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
  - "\uB178\uD06C\uBAA8\uB974\uB294 \uC774\uBBF8 \uC5EC\uB7EC \uC655\uC744 \uD3D0\uC704\uD558\uACE0,
    \uAD00\uB9AC\uB4E4\uC744 \uC8FD\uC600\uC2B5\uB2C8\uB2E4."
  - "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uBC84\uD2F0\uC2E0 \uD53C\uC544\uB7ED\uC2A4\uC758
    \uAD6D\uC655\uAED8\uC11C\uB294 \uD611\uC0C1\uC744 \uC704\uD574 \uB9C8\uC655\uC131\uC73C\uB85C
    \uAC04 \uC774\uD6C4 \uD589\uBC29\uC774 \uBB18\uC5F0\uD558\uC2ED\uB2C8\uB2E4."
  - "\uC544\uB9C8 \uD611\uC0C1\uC774 \uACB0\uB82C\uB418\uC5B4 \uAC10\uAE08\uB418\uC168\uACA0\uC9C0\uC694."
  - "\uBFD0\uB9CC \uC544\uB2C8\uB77C \uD3C9\uBC94\uD55C \uC0AC\uB78C\uB4E4\uAE4C\uC9C0
    \uC57D\uD0C8\uD558\uACE0, \uBD99\uC7A1\uC544 \uC2E4\uD5D8\uCCB4\uB85C \uC4F0\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC774\uB300\uB85C\uBA74 \uADF8\uB807\uAC8C \uB9CC\uB4E4\uC5B4\uC9C4 \uBAAC\uC2A4\uD130\uB4E4\uC5D0\uAC8C
    \uC138\uACC4\uAC00 \uC810\uB839\uB2F9\uD558\uACE0 \uB9D9\uB2C8\uB2E4. \uBD80\uB514
    \uB3C4\uC640\uC8FC\uC138\uC694\u22EF\u22EF."
  - "\uC544\uB2C8, \uADF8\uB807\uAC8C \uB9D0\uC500\uD558\uC154\uB3C4 \uC800\uB294\u22EF
    \uD2B9\uBCC4\uD55C \uC774\uB2A5\uB825\uC790 \uAC19\uC740 \uAC83\uB3C4 \uC544\uB2CC\uAC78\uC694."
  - "\uADF8\uB7F4 \uB9AC\uAC00\uC694. \uC138\uACC4\uB97C \uB118\uC5B4\uC624\uBA70
    \uBB34\uC5B8\uAC00 \uBCC0\uD588\uC744 \uAC81\uB2C8\uB2E4."
  - "\uC9D1\uC911\uD574\uC11C \uC190\uC744 \uBAA8\uC544\uBCF4\uC2DC\uACA0\uC5B4\uC694?"
  - "\uCC28\uB974\uB374\uC758 \uB9D0\uB300\uB85C \uC190\uC744 \uBAA8\uC73C\uC790
    \uD478\uB978 \uBE5B\uC758 \uBB34\uC5B8\uAC00\uAC00 \uBC1C\uC0AC\uB418\uC5C8\uB2E4."
  - "\uC774\u22EF \uC774\uAC8C \uBB50\uC8E0? \uBB54\uAC00 \uB098\uC654\uB294\uB370?!"
  - "\uC6A9\uC0AC\uB2D8\uAED8\uC11C\uB294 \uBC14\uB78C\uC758 \uCD95\uBCF5\uC744 \uBC1B\uC73C\uC168\uAD70\uC694!"
  - "\uADF8\uB798\uC11C \uBA38\uB9AC\uCE74\uB77D\uB3C4 \uC774\uB7F0 \uC0C9\uC774
    \uB41C \uAC74\uAC00?"
  - "\uC6A9\uC0AC\uB2D8\uC774\uC2DC\uB77C\uBA74 \uCDA9\uBD84\uD788 \uB9C8\uC655\uC744
    \uBB3C\uB9AC\uCE58\uC2E4 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4. \uC544, \uC774\uAC74\u22EF"
  - "\uD53C\uC544\uB7ED\uC2A4 \uAD6D\uC655\uC774\uC2E0 \uB9AC\uC170\uB808 \uB2D8\uC758
    \uCD08\uC0C1\uD654\uC785\uB2C8\uB2E4."
  - "\u22EF\uC655\uC774 \uC774\uB807\uAC8C \uC544\uB984\uB2E4\uC6CC\uB3C4 \uB418\uB294
    \uAC70\uC57C?"
  - "\uC6CC\uB099 \uB208\uC5D0 \uB744\uB294 \uBD84\uC774\uC2DC\uB2C8 \uBC14\uB85C
    \uC54C\uC544\uBCF4\uC2E4 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4. \uAC07\uD600
    \uACC4\uC2E4 \uB9AC\uC170\uB808 \uB2D8\uB3C4 \uAD6C\uD574\uC8FC\uC138\uC694."
  - "\u22EF\u22EF."
  - "\uBB34\uC2A8 \uC18C\uC124\uB3C4 \uC544\uB2C8\uACE0. \u22EF\uB3CC\uC544\uAC00\uB824\uBA74
    \uB3C4\uC640\uC8FC\uB294 \uC218\uBC16\uC5D0 \uC5C6\uACA0\uC9C0?"
  - "\u22EF\uCD5C\uB300\uD55C \uB178\uB825\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uC6A9\uC0AC\uB2D8\u22EF\u22EF! \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC815\uB9D0
    \uAC10\uC0AC\uD574\uC694."
  - "\uC774\uAC83\uB4E4\uB3C4 \uCC59\uAE30\uC2DC\uC9C0\uC694."
  - "\uC5EC\uC815\uC5D0 \uB3C4\uC6C0\uC774 \uB420 \uB9CC\uD55C \uBB3C\uC57D\uC785\uB2C8\uB2E4."
  - "\uAE38\uC740 \uC6A9\uC0AC\uB2D8\uC774 \uC774\uCABD\uC73C\uB85C \uB118\uC5B4\uC624\uC2DC\uBA70
    \uD568\uAED8 \uC0DD\uACA8\uB09C \uB9C8\uC11D\uC774 \uC548\uB0B4\uD574 \uC904
    \uAC83\uC785\uB2C8\uB2E4."
  - "\uC6A9\uC0AC\uB2D8 \uC190\uB4F1\uC758 \uADF8 \uCD08\uB85D\uC0C9 \uB3CC\uC774\uC5D0\uC694."
  - "\uC6A9\uC0AC\uB2D8\uC758 \uBAA8\uD5D8\uC5D0 \uBE5B\uC758 \uC2E0\uC758 \uCD95\uBCF5\uC774
    \uC788\uAE30\uB97C."
  - "\uBB34\uC6B4\uC744 \uBE55\uB2C8\uB2E4."
  - "\u22EF\uC870\uAE08 \uAE30\uB300\uB418\uAE34 \uD558\uB124. \uB0B4\uAC00 \uC5EC\uAE30\uC11C\uB294
    \uC8FC\uC778\uACF5\uC778 \uAC74\uAC00?"
  - "\uB0B4 \uAE38\uACE0\uB3C4 \uC9E7\uC740 \uC5EC\uD589\uC740, \uC774\uB807\uAC8C
    \uC870\uAE08 \uB72C\uAE08\uC5C6\uC774 \uC2DC\uC791\uB418\uC5C8\uB2E4\u22EF\u22EF."
