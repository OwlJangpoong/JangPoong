  - {fileID: 11400000, guid: 0392ab6c62f7943cc95d3977759f4138, type: 2}
  - {fileID: 0}
  paragraphs:
  - "\uD760\u22EF \uC5EC\uAE30\uAC00 \uB9C8\uC655\uC131\uC778\uAC00? \uB531 \uBD10\uB3C4
    \uADF8\uB7F0 \uAC83 \uAC19\uC740\uB370."
  - "\uB204\uAD6C\uB0D0."
  - "\uB531 \uBD10\uB3C4 \uB9C8\uC655\uC774\uAD70. \uBCF4\uD1B5 \uC774\uB7F0 \uC0C1\uD669\uC5D0\uC11C
    \uCE58\uB294 \uB300\uC0AC\uB294\u22EF"
  - "\uB098\uB294 \uB110 \uCC98\uCE58\uD558\uB7EC \uC628 \uBC14\uB78C\uC758 \uC6A9\uC0AC!"
  - "\uC774 \uC0AC\uC545\uD55C \uB9C8\uC655! \uBE68\uB9AC \uD53C\uC544\uB7ED\uC2A4
    \uAD6D\uC655\uC744 \uB3CC\uB824\uC918!"
  - "\u22EF\uC0C1\uB2F9\uD788 \uBD80\uB044\uB7FD\uB124."
  - "\uAC11\uC790\uAE30 \uCCD0\uB4E4\uC5B4\uC640\uC11C \uADF8\uAC8C \uBB34\uC2A8
    \uC18C\uB9AC\uC9C0? \uB0B4\uAC00 \uB9C8\uC655\uC774\uB77C\uACE0?"
  - "\u22EF\u22EF\uBB50? \uC544, \uC544\uB2C8\uC57C???"
  - "\u22EF\uB0B4\uAC00 \uC801\uC9C0 \uC54A\uC740 \uC6A9\uC0AC\uB4E4\uC744 \uBD10\uC654\uC9C0\uB9CC,
    \uB108 \uAC19\uC740 \uC790\uC2DD\uC740 \uCC98\uC74C\uC774\uB2E4."
  - "\u22EF\u22EF."
  - "\uB9DE\uB2E4\uB294 \uC18C\uB9AC\uC796\uC544!!!!!!"
  - "\uB9C8\uC655\uC774\uB77C\uACE0 \uBD88\uB9AC\uB294 \uAC78 \uC120\uD638\uD558\uC9C4
    \uC54A\uC544\uC11C \uB9D0\uC774\uC9C0\u22EF."
  - "\uB10C \uCC28\uB974\uB374\uC774 \uC18C\uD658\uD55C \uB140\uC11D\uCE58\uACE0\uB294\u22EF"
  - "\u22EF\uC774\uBC88\uC5D0\uB294 \uC815\uB9D0 \uBCC4 \uBCFC \uC77C \uC5C6\uC5B4
    \uBCF4\uC774\uB294\uAD6C\uB098."
  - "\uC9C0\uAE08 \uB9D0 \uB2E4 \uD588\uC5B4?!"
  - "\uC774\uC804\uC758 \uB545, \uBB3C, \uBD88\u22EF \uADF8\uB798, \uBD88\uC758 \uD798\uC744
    \uAC00\uC9C4 \uB140\uC11D\uC740 \uC81C\uBC95 \uAD1C\uCC2E\uC558\uB2E4\uB9CC."
  - "\uB10C \uADF8 \uB140\uC11D\uCC98\uB7FC 300\uB144\uC740 \uBB34\uC2A8, \uB0A0
    3\uCD08\uB3C4 \uBD09\uC778\uD558\uC9C0 \uBABB\uD560 \uC815\uB3C4\uB85C \uB9F9\uD558\uAC8C
    \uC0DD\uACBC\uAD70."
  - "\uB545, \uBB3C, \uBD88? \uB0B4\uAC00 \uAC00\uC9C0\uACE0 \uC788\uB294 \uC544\uD2F0\uD329\uD2B8\uB4E4\uC758
    \uC8FC\uC778\uC778\uAC00?"
  - "\uB0B4 \uC218\uD558\uB188\uC774 \uC790\uC2E0\uC744 \uD76C\uC0DD\uD574 \uADF8
    \uBD09\uC778\uAE4C\uC9C0 \uD480\uC5B4\uC92C\uAC70\uB298\u22EF"
  - "\uB0A0 \uBC18\uACA8\uC8FC\uB294 \uAC83\uC774 \uB108 \uB530\uC704\uB77C\uACE0?"
  - "\uC774\uAC83 \uCC38 \uAE40\uC774 \uC0C8\uB294\uAD6C\uB098."
  - "\uB108\u22EF \uC0AC\uB78C\uC744 \uB108\uBB34 \uBB34\uC2DC\uD558\uB294 \uAC83
    \uC544\uB0D0?"
  - "\uADF8\uB7EC\uB294 \uB108\uC57C\uB9D0\uB85C \uD560 \uC904 \uC544\uB294 \uAC70\uB77C\uACE0\uB294
    \uD798\uC5C6\uB294 \uC0AC\uB78C\uB4E4 \uAD34\uB86D\uD788\uAE30\uBFD0\uC774\uC5C8\uC73C\uBA74\uC11C."
  - "\uB450\uACE0 \uBD10. \uC624\uB9CC\uD55C \uAC83\uB3C4 \uC5EC\uAE30\uAE4C\uC9C0\uC77C
    \uD14C\uB2C8\uAE4C."
  - "\uD3EC\uBD80 \uD558\uB098\uB294 \uB4E4\uC5B4\uC904 \uB9CC\uD558\uAD70."
  - "\uADF8\uB798\u22EF\u22EF. \uC5B4\uB514 \uD55C \uBC88 \uB364\uBCBC\uBCF4\uAC70\uB77C."
  - "\uADF8 \uAC00\uB0D8\uD508 \uBAA9\uC228\uC744 \uBD80\uC9C0\uD558\uACE0 \uC2F6\uB2E4\uBA74
    \uC9C0\uAE08\uC774\uB77C\uB3C4 \uB3C4\uB9DD\uCCD0\uC57C\uACA0\uC9C0\uB9CC!"
  - "\uD558, \uB3C4\uB9DD\uCE60 \uAC70\uBA74 \uC5EC\uAE30\uAE4C\uC9C0 \uC624\uC9C0\uB3C4
    \uC54A\uC558\uC5B4!"
