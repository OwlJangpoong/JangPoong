  - {fileID: 11400000, guid: ab46d034521c14329933db700cb54fde, type: 2}
  - {fileID: 0}
  - {fileID: 0}
  paragraphs:
  - "\uD734\u22EF\u22EF. \uC704\uD5D8\uD588\uB124. \uB2E4\uC74C\uBD80\uD130\uB294
    \uB9D0\uC744 \uC880 \uC870\uC2EC\uD574\uC57C\u22EF"
  - "\uAC00, \uAC00, \uAC00, \uAC10\uC0AC\uD569\uB2C8\uB2E4!!!"
  - "\uBB50\uC57C! \uC544\uC9C1 \uB0A8\uC544 \uC788\uC5C8\uB2E4\uACE0?"
  - "\uC544\uB2C8, \uC7A0\uAE50. \uB108\uB294\u22EF \uBD84\uBA85 \uC544\uAE4C \uBC2D\uC77C\uD558\uACE0
    \uC788\uB358 \uC560\uC9C0?"
  - "\uB124, \uB124! \uC800\uB294 \uB9C8, \uB9C8\uC655 \uB178\uD06C\uBAA8\uB974\uC758
    \uC218\uD558\uB3C4 \uC544\uB2C8\uC5D0\uC694\u22EF\u22EF."
  - "\uBB50? \uB108\uB3C4 \uB9AC\uC790\uB4DC\uB9E8\uC774\uC796\uC544?"
  - "\uB124, \uB9C8, \uB9DE\uC544\uC694. \uD558\uC9C0\uB9CC\u22EF \uD638, \uD639\uC2DC
    \uC120\uC0DD\uB2D8\uAED8\uC11C\uB294 \uB9AC\uC790\uB4DC\uB9E8 \uC870, \uC885\uC871\uC5D0
    \uB300\uD574 \uC5BC\uB9C8\uB098 \uC54C\uACE0 \uACC4\uC2E0\uAC00\uC694?"
  - "\u22EF\u22EF. \uAC8C\uC784\uC5D0 \uB098\uC624\uB294 \uB3C4\uB9C8\uBC40. \u22EF\uADF8\uB807\uAC8C
    \uB9D0\uD558\uBA74 \uC548 \uB418\uACA0\uC9C0."
  - "\uC800, \uC800\uD76C\uB294\uC694\u22EF\u22EF. \uBCF4\uC2DC\uB2E4\uC2DC\uD53C
    \uC774, \uC778\uAC04\uB4E4\uACFC\uB3C4, \uC9C0\uB2A5\uC774 \uAC70\uC758 \uC5C6\uB294
    \uB2E4, \uB2E4\uB978 \uBAAC\uC2A4\uD130\uB4E4\uACFC\uB3C4 \uB2EC\uB77C\uC694."
  - "\uADF8\uB798\uC11C \uC800\uD76C\uB07C\uB9AC \uB9C8, \uB9C8\uC744\uC744 \uB9CC\uB4E4\uC5B4\uC11C
    \uD3C9\uD654\uB86D\uAC8C \uC0AC, \uC0B4\uC558\uB294\uB370\u22EF"
  - "\uB9C8, \uB9C8\uC655 \uB178\uD06C\uBAA8\uB974\uC758 \uBD80\uD558\uB4E4\uC774
    \uB2E4, \uB2E4\uB140\uAC00\uACE0\uC11C\uB294, \uBAA8\uB4E0 \uAC8C \uB2EC\uB77C\uC84C\uC5B4\uC694."
  - "\uC6D0\uB798 \uC800\uB7F0 \uB188\uB4E4\uC774 \uC544\uB2C8\uC5C8\uB2E4\uB294
    \uB9D0\uC774\uC57C?"
  - "\uB124, \uB124\u22EF. \uCC98\uC74C\uC5D0\uB294 \uADF8\uB0E5 \uB9C8, \uB9D0\uB2E4\uD23C\uC744
    \uD558\uB294 \uC815\uB3C4\uC600\uC5B4\uC694."
  - "\uB9C8\uC655\uC758 \uB354 \uD070 \uD788, \uD798\uC744 \uC900\uB2E4\uB294 \uB9D0\uC5D0
    \uB118\uC5B4\uAC04 \uB9C8\uC655\uD30C\uC640, \uC870\uC6A9\uD788 \uC788\uC790\uB294
    \uC628\uAC74\uD30C\uAC00 \uC218\uC2DC\uB85C \uB2E4, \uB2E4\uD25C\uC8E0."
  - "\uADF8, \uADF8\uB7F0\uB370, \uB9C8\uC655 \uB178\uD06C\uBAA8\uB974\uAC00 \uAE68\uC5B4\uB098\uACE0\u22EF"
  - "\uB108, \uB108\uBB34 \uAC15\uD574\uC11C \uC800\uD76C\uB294\u22EF \uC804\uD600
    \uB300\uD56D\uD560 \uC218\uAC00 \uC5C6\uC5C8\uC8E0. \uBAA9\uC228\uC744 \uBD80\uC9C0\uD558\uB294
    \uAC8C \uACE0\uC791\uC774\uC5C8\uC5B4\uC694\u22EF\u22EF."
  - "\uC544, \uC124\uB9C8 \uC77C\uC744 \uD558\uACE0 \uC788\uB358 \uB9AC\uC790\uB4DC\uB9E8\uB4E4\uC774\u22EF\u22EF."
  - "\uB9C8, \uB9DE\uC544\uC694. \uC628\uAC74\uD30C\uB4E4\uC774\uC5D0\uC694."
  - "\u22EF\uD55C\uB54C \uB3D9\uB8CC\uB4E4\uC774\uC5C8\uB358 \uC774\uB4E4\uC774 \uC774,
    \uC774\uB807\uAC8C \uC4F0\uB7EC\uC9C4 \uAC74 \uC2AC\uD504\uC9C0\uB9CC, \uAD6C\uD574\uC8FC\uC154\uC11C
    \uB2E4\uC2DC \uD55C\uBC88 \uAC00, \uAC10\uC0AC\uD574\uC694."
  - "\uC544, \uC544\uB9C8 \uB9C8\uC655\uD30C \uC218\uC7A5\uC758 \uADFC\uCC98\uC5D0\u22EF
    \uC5F4\uC1E0\uAC00 \uC788\uC744 \uD150\uB370, \uCC28, \uCC3E\uC544\uC640 \uC8FC\uC2E4
    \uC218 \uC788\uB098\uC694?"
  - "\uADF8, \uC11C, \uC120\uC0DD\uB2D8\uAED8 \uD544\uC694\uD560 \uAC83 \uAC19\uC740
    \uBB3C\uAC74\uC774 \uC788\uB294\uB370, \uC7A0\uACA8 \uC788\uC5B4\uC11C\u22EF\u22EF."
  - "\u22EF\uB108\uBB34 \uB5A8\uC9C0 \uB9C8\uC694. \uC54C\uACA0\uC73C\uB2C8\uAE4C
    \uAE30\uB2E4\uB9AC\uC138\uC694."
  - "\uB9C8, \uB9C8\uC655\uC744 \uBB34\uCC0C\uB974\uB7EC\u22EF \uAC04\uB2E4\uACE0
    \uD558\uC168\uC8E0?"
  - "\uBD84\uBA85 \uC774\uAC8C \uB3C4, \uB3C4\uC6C0\uC774 \uB420 \uAC70\uC608\uC694."
  - "\uBB34\uC6B4\uC744 \uBE4C\uC5B4\uC694\u22EF\u22EF."
  - "\u22EF\uC774\uAC74 \uC608\uC0C1\uCE58 \uBABB\uD55C \uC218\uD655\uC774\uB124\uC694."
  - "\uACE0\uB9C8\uC6CC\uC694. \uC791\uC740 \uB9AC\uC790\uB4DC\uB9E8 \uC528\uB3C4
    \uBD80\uB514 \uBB34\uC0AC\uD558\uC2DC\uAE38."
