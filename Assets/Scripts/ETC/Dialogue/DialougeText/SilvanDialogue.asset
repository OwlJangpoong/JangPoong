  - {fileID: 11400000, guid: e99ee9f3587a3e84b96384956f0455e9, type: 2}
  paragraphs:
  - "\uB204\uCD94\uD558\uC9C0\uB9CC, \uD3B8\uD788 \uC26C\uC2DC\uC9C0\uC694."
  - "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC740\uC778\uB2D8\uAED8\uC11C\uB294 \uC5B4\uCA4C\uB2E4
    \uADF8\uACF3\uC5D0 \uACC4\uC168\uB358 \uAC81\uB2C8\uAE4C?"
  - "\uC774 \uBD80\uADFC\uC5D0 \uC788\uB294 \uC0AC\uB78C \uC0AC\uB294 \uACF3\uC774\uB77C\uACE0\uB294
    \uC800\uD76C \uB9C8\uC744\uBFD0\uC774\uACE0, \uC800 \uC232 \uB108\uBA38\uC5D0\uB294
    \uB9C8\uC655\uC131\uBC16\uC5D0 \uC5C6\uC2B5\uB2C8\uB2E4\uB9CC\u22EF\u22EF."
  - "\uC544, \uBC14\uB85C \uADF8 \uB9C8\uC655\uC131\uC73C\uB85C \uAC00\uACE0 \uC788\uC5C8\uC5B4\uC694.
    \uC81C\uAC00 \uB9DE\uAC8C \uAC00\uACE0 \uC788\uC5C8\u22EF"
  - "\uB124??? \uC544\uB2C8, \uADF8\uACF3\uC5D0\uB294 \uBB34\uC5C7 \uD558\uB7EC \uAC00\uC2ED\uB2C8\uAE4C?
    \uD3C9\uBC94\uD55C \uC0AC\uB78C\uC774 \uAC00\uBD24\uC790 \uAC1C\uC8FD\uC74C\uC774\uB098\u22EF"
  - "\u22EF\uC7A0\uC2DC\uB9CC\uC694, \uC740\uC778\uB2D8 \uC190\uB4F1\uC758 \uADF8
    \uB3CC\uC740\u22EF\u22EF."
  - "\uD639\uC2DC \uB9C8\uBC95\uC0AC \uCC28\uB974\uB374\uB2D8\uAED8\uC11C \uC18C\uD658\uD558\uC2E0
    \uC6A9\uC0AC\uB2D8\uC774\uC2ED\uB2C8\uAE4C?"
  - "\uC640, \uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uC544\uC168\uC5B4\uC694? \uB9DE\uC544\uC694.
    \uBC14\uB78C\uC758 \uC6A9\uC0AC\uC600\uB098? \uBB50 \uADF8\uB7F0 \uAC78\uB85C
    \uC18C\uD658\uB418\uC5C8\uB124\uC694."
  - "\u22EF\u22EF\uADF8\uB807\uAC8C \uB41C \uAC70\uC600\uAD70\uC694. \u22EF\uC2E4\uBE44\uC624."
  - "\uC138\uACC4\uB97C \uAD6C\uD574\uC8FC\uC2E4 \uC6A9\uC0AC\uB2D8\uAED8 \uC870\uAE08\uC774\uB77C\uB3C4
    \uB3C4\uC6C0\uC774 \uB418\uC5B4\uC57C\uACA0\uC9C0\uC694."
  - "\uADF8\uB54C\uAE4C\uC9C0 \uAD81\uAE08\uD55C \uAC83\uC774 \uC788\uC73C\uC2DC\uB2E4\uBA74
    \uD3B8\uD558\uAC8C \uBB3C\uC5B4\uBD10 \uC8FC\uC138\uC694."
  - "\uC624? \uADF8\uB807\uB2E4\uBA74\u22EF \uC544\uAE4C \uC2E4\uBE44\uC624\uAC00
    \uD55C \uB9D0\uC774 \uB9C8\uC74C\uC5D0 \uAC78\uB9AC\uB294\uB370\uC694."
  - "\uC0AC\uB78C\uB4E4\uC744 \uB9C8\uC655\uC131\uC73C\uB85C \uB04C\uACE0 \uAC04\uB2E4\uB294
    \uAC8C \uBB34\uC2A8 \uC18C\uB9AC\uC778\uAC00\uC694?"
  - "\u22EF\uB4E4\uB9AC\uB294 \uB9D0\uB85C\uB294 \uB9C8\uC655\uC774 \uC601\uC0DD\uC744
    \uC704\uD574 10,000\uBA85\uC758 \uC5B4\uB9B0 \uC601\uD63C\uC744 \uC218\uC9D1\uD558\uACE0
    \uC788\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
  - "\uC544\uB9C8 \uB04C\uB824\uAC04 \uCCAD\uB144\uB4E4\uC740 \uADF8\uB97C \uC704\uD55C
    \uC758\uC2DD\uC744 \uC900\uBE44\uD558\uAE30 \uC704\uD574 \uC77C\uC744 \uD558\uACE0
    \uC788\uC744 \uAC83\uC774\uACE0,"
  - "\uC5B4\uB5BB\uAC8C \uADF8\uB7F4 \uC218\uAC00\u22EF\u22EF."
  - "\u22EF\uC774\uB807\uAC8C \uB208\uC55E\uC5D0\uC11C \uBCF8 \uC774\uC0C1, \uB0B4\uBC84\uB824\uB450\uAE30\uB294
    \uC880 \uADF8\uB7F0 \uAC83 \uAC19\uC544."
  - "\uC8FC\uC778\uACF5\uCC98\uB7FC\u22EF \uC774\uAC83\uB3C4 \uB0B4\uAC00 \uD574\uB0B4\uC57C
    \uD558\uB294 \uC77C\uC774\uACA0\uC9C0."
  - "\u22EF\uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694. \uC544\uC9C1
    \uC758\uC2DD\uC774 \uC2DC\uC791\uB41C \uAC74 \uC544\uB2C8\uB77C\uB294 \uB73B\uC774\uC796\uC544\uC694?"
  - "\uD639\uC2DC \uB9C8\uC655\uC5D0 \uB300\uD55C \uC815\uBCF4\uB3C4 \uC788\uC73C\uC2E0\uAC00\uC694?"
  - "\uC6A9\uC0AC\uB2D8\u22EF\u22EF!"
  - "\u22EF\u22EF.  \u22EF\uB9C8\uC655\uC740 \uCD5C\uADFC\uC5D0 \uAE68\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4."
  - "\uC57D 100\uB144 \uC804, \uBD88\uC758 \uC6A9\uC0AC\uB2D8\uAED8\uC11C \uB9C8\uC655\uC744
    \uBD09\uC778\uD588\uB294\uB370\u22EF\u22EF."
  - "\uADF8 \uD798\uC774 \uB2E4\uD588\uB2E4\uAE30\uBCF4\uB2E4\uB294\u22EF \uB204\uAD70\uAC00\uC758
    \uAC1C\uC785\uC774 \uC788\uC5C8\uB358 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB7FC \uB9C8\uC655 \uCC98\uCE58\uC5D0\uB294 \uC774\uBBF8 \uB204\uAC00
    \uD55C \uBC88 \uC2E4\uD328\uD588\uB2E4\uB294 \uB73B \uC544\uB2CC\uAC00\uC694?"
  - "\uB9C8\uC655\uC744 \uC18C\uBA78\uC2DC\uD0A4\uB294 \uAC83\uC740 \uC5EC\uAC04
    \uC5B4\uB824\uC6B4 \uC77C\uC774 \uC544\uB2C8\uC9C0\uC694."
  - "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8\u22EF \uC774\uAC83\uBD80\uD130 \uB4DC\uB824\uC57C\uACA0\uAD70\uC694.
    (\uB3CC \uC544\uD2F0\uD329\uD2B8\uB97C \uAC74\uB128\uB2E4. \uC774\uBBF8\uC9C0
    \uCD9C\uB825 + \uC2E4\uBC18 \uC774\uBBF8\uC9C0 \uBCC0\uACBD)"
  - "\uBD88\uC758 \uC6A9\uC0AC\uB2D8\uAED8\uC11C \uD6D7\uB0A0 \uC9C4\uC815\uC73C\uB85C
    \uB9C8\uC655\uC744 \uCC98\uCE58\uD560 \uB54C\uAC00 \uC628\uB2E4\uBA74\u22EF"
  - "\uADF8\uB97C \uD574\uB0BC \uBC14\uB78C\uC5D0\uAC8C \uC774 \uB3CC\uC744 \uC804\uD574\uB2EC\uB77C
    \uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uADF8 \uB204\uAD6C\uB3C4 \uBB34\uC2A8 \uB73B\uC778\uC9C0 \uBAB0\uB790\uC9C0\uB9CC,
    \uC544\uBB34\uB798\uB3C4 \uC6A9\uC0AC\uB2D8\uC744 \uC77C\uCEEB\uB294 \uB9D0 \uAC19\uAD70\uC694."
  - "\u22EF\uC81C \uC190\uB4F1\uC5D0 \uB2EC\uB9B0 \uAC83\uACFC \uC0C9\uB9CC \uB2E4\uB974\uC9C0
    \uB611\uAC19\uC774 \uC0DD\uACBC\uB124\uC694?"
  - "\uC608. \uADF8\uB798\uC11C \uC81C\uAC00 \uBC14\uB85C \uC54C\uC544\uBCF4\uC558\uC9C0\uC694."
  - "\uB9CC\uC57D \uC81C\uAC00 \uD574\uB0B4\uC9C0 \uBABB\uD558\uBA74 \uC5B4\uCA4C\uC2DC\uB824\uACE0
    \uC774\uAC83\uAE4C\uC9C0 \uC8FC\uC138\uC694?"
  - "\uC544\uB2C8\uC694, \uC800\uB294 \uD655\uC2E0\uD569\uB2C8\uB2E4. \uADF8\uAC8C
    \uC544\uB2C8\uB354\uB77C\uB3C4, \uAD6C\uD574\uC8FC\uC2E0 \uC740\uC778\uAED8 \uC870\uAE08\uC774\uB77C\uB3C4
    \uB3C4\uC6C0\uC774 \uB418\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
  - "\uC774\uAC83\uB4E4\uB3C4 \uBC1B\uC73C\uC2DC\uC9C0\uC694."
  - "\uC544\uB2C8, \uBB58 \uC774\uB807\uAC8C \uB9CE\uC774\u22EF\u22EF. \uADF8\uB7F0\uB370
    \uC774 \uD22C\uBA85\uD55C \uD3EC\uC158\uC740 \uBB50\uC8E0?"
  - "\uBD88\uC758 \uC6A9\uC0AC\uB2D8\uAED8\uC11C \uC774 \uB9C8\uC744\uC5D0 \uD568\uAED8
    \uB0A8\uAE30\uC2E0 \uD3EC\uC158\uC785\uB2C8\uB2E4."
  - "\uC800\uD76C\uB294 \uC0AC\uC6A9\uD574 \uBCF8 \uC801\uC774 \uC5C6\uC9C0\uB9CC,
    \uBAAC\uC2A4\uD130\uB97C \uD53C\uD574 \uC740\uC2E0\uD560 \uC218 \uC788\uAC8C
    \uB41C\uB2E4\uACE0 \uC804\uD574\uC9D1\uB2C8\uB2E4."
  - "\uC640, \uC2E0\uAE30\uD55C \uD3EC\uC158\uC774\uB124\uC694. \uB354 \uB9CC\uB4E4
    \uC218\uB294 \uC5C6\uB098\uC694?"
  - "\uC608, \uC544\uC27D\uAC8C\uB3C4\u22EF\u22EF. \uC81C\uC870\uBC95\uC740 \uC804\uD574\uC9C0\uC9C0
    \uC54A\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB807\uAD6C\uB098\u22EF\u22EF. \uADF8\uB7F0 \uADC0\uD55C \uBB3C\uAC74\uC744
    \uC8FC\uC2E0\uB2E4\uB2C8 \uC815\uB9D0 \uAC10\uC0AC\uD574\uC694."
  - "\uADF8\uB7F0\uB370 \uC774\uB807\uAC8C \uD37C\uC8FC\uC154\uB3C4 \uB418\uB098\uC694?
    \uC774\uC7A5\uB2D8\uC740 \uC5B4\uB5BB\uAC8C \uD558\uC2E4 \uAC74\uAC00\uC694?"
  - "\uC800\uB294 \uC774\uC81C \uB0A8\uC740 \uC774\uB4E4\uACFC \uB9C8\uC744\uC758
    \uBC29\uC5B4\uC120\uC744 \uB2E4\uC2DC \uAD6C\uCD95\uD558\uACE0, \uD68C\uBCF5\uC5D0
    \uC804\uB150\uD574\uC57C\uACA0\uC9C0\uC694."
  - "\uC774\uBBF8 \uC7A1\uD600\uAC04 \uC0AC\uB78C\uB4E4\uC740\u22EF\u22EF."
  - "\u22EF\uB530\uB2D8\uC774 \uAC71\uC815\uB418\uC2DC\uB294 \uAC70\uC8E0?"
  - "\uAC71\uC815\uD558\uC9C0 \uB9C8\uC2DC\uB77C\uB2C8\uAE4C\uC694. \uC0AC\uB78C\uB4E4\uC744
    \uAD6C\uD558\uB294 \uAC74 \uC81C\uAC8C \uB9E1\uACA8\uC8FC\uC138\uC694."
  - "\uC6A9\uC0AC\uB2D8\u22EF\u22EF."
  - "\uC774 \uB9C8\uC744\uC740 \uC5B8\uC81C\uAE4C\uC9C0\uB098 \uC6A9\uC0AC \uB2D8\uC758
    \uC740\uD61C\uB97C \uAE30\uC5B5\uD560 \uAC83\uC785\uB2C8\uB2E4."
  - "\uC804\u22EF \uD560 \uC218 \uC788\uB294 \uC77C\uC744 \uD55C \uAC83\uBFD0\uC778\uAC78\uC694."
  - "\uD560 \uC218 \uC788\uB2E4\uACE0 \uD558\uC5EC \uBAA8\uB450\uAC00 \uD589\uB3D9\uC5D0
    \uC62E\uAE30\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4."
  - "\uBD80\uB514 \uC6A9\uC0AC \uB2D8\uAED8 \uBB34\uC6B4\uC774 \uC788\uAE30\uB97C
    \uBC14\uB77C\uBA70,"
  - "\uC800\uD76C \uC9D1\uC5D0\uC11C \uC870\uAE08 \uC26C\uC5C8\uB2E4 \uAC00\uC2DC\uC9C0\uC694."
