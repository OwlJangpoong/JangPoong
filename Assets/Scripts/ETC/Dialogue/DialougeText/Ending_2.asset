  - {fileID: 0}
  paragraphs:
  - "\u22EF\uAC89\uBCF4\uAE30\uC640\uB294 \uC0C1\uB2F9\uD788 \uB2E4\uB974\uAD70."
  - "\uC124\uB9C8 \uC774\uB807\uAC8C \uB05D\uB0A0 \uC904\uC740\u22EF\u22EF."
  - "\uB9D0\uD588\uC796\uC544. \uC5EC\uAE30\uAE4C\uC9C0\uB77C\uACE0."
  - "\uADF8\uB798. \uC774\uC57C\uAE30\uC758 \uB05D\uC744 \uC815\uD558\uB294 \uAC83\uC740
    \uC8FC\uC778\uACF5\uC778 \uBC95\uC774\uB2E4."
  - "\uB9C8\uC655\uC774 \uC18C\uBA78\uD558\uC790 \uAD6C\uC2AC\uCC98\uB7FC \uC0DD\uAE34
    \uAC83\uACFC \uBB18\uD55C \uC5F4\uC1E0 \uD558\uB098\uAC00 \uADF8 \uC790\uB9AC\uC5D0
    \uB0A8\uB294\uB2E4."
  - "\uC774\uAC74 \uBB50\uC9C0? \uC77C\uB2E8 \uCC59\uACA8\uB458\uAE4C\u22EF."
  - "\uD734, \uC774\uC81C \uC815\uB9D0 \uB05D\uC774\uACA0\uC9C0? \uD558\uB9C8\uD130\uBA74
    \uB0B4\uAC00 \uB2F9\uD560 \uBED4\uD588\uB124."
  - "\uB204\uAD6C\u22EF \uC5C6\uC2B5\uB2C8\u22EF\u22EF!"
  - "\u22EF\uBC29\uAE08 \uC800\uCABD\uC5D0\uC11C \uBB34\uC2A8 \uC18C\uB9AC\uAC00
    \uB4E4\uB9B0 \uAC83 \uAC19\uC740\uB370?"
  - "\uAC00\uBD10\uC57C\uACA0\uC9C0? \uC6A9\uC0AC\uB2C8\uAE4C!"
  - "\uB204\uAD6C \uC788\uC2B5\uB2C8\u22EF \uC544, \uB2F9\uC2E0\uC740?"
  - "\uC544\uC544\u22EF \uB4DC\uB514\uC5B4 \uC0AC\uB78C\uC774\u22EF!"
  - "\uC608\uC058\uB2E4\u22EF\u22EF. \uD5C9, \uC774\uAC8C \uC544\uB2C8\uB77C."
  - "\uB098\uB294 \uD53C\uC544\uB7ED\uC2A4\uC758 \uAD6D\uC655, \uB9AC\uC170\uB808\uB77C
    \uD558\uC624."
  - "\uADF8\uB300\uB294\u22EF \uCC28\uB974\uB374\uC774 \uC18C\uD658\uD55C \uC6A9\uC0AC\uC778\uAC00?"
  - "\uC5C7, \uC5B4\uB5BB\uAC8C \uC544\uC168\uC5B4\uC694?"
  - "\uADF8\uB798\u22EF\u22EF. \uC5ED\uC2DC \uADF8\uB7AC\uAD70."
  - "\uD56D\uC0C1 \uC774 \uB545\uC5D0 \uC704\uAE30\uAC00 \uB2E5\uCCD0\uC654\uC744
    \uB54C, \uC6B0\uB9AC\uB97C \uAD6C\uD574\uB0B8 \uAC83\uC740 \uC774\uACC4\uC758
    \uC6A9\uC0AC\uC600\uB124."
  - "\uC774\uBC88\uC5D0\uB3C4 \uADF8\uB7AC\uACA0\uAC70\uB2C8 \uCD94\uCE21\uD55C \uAC83\uBFD0\uC774\uC9C0.
    \uB9C8\uC655\uC740 \uB610 \uD55C \uBC88 \uBD09\uC778\uB41C \uAC83\uC778\uAC00?"
  - "\uC544\uD558. \u22EF\uB531\uD788 \uBD09\uC778\uD55C\uB2E4\uB294 \uB290\uB08C\uC740
    \uC548 \uB4E4\uC5C8\uC9C0\uB9CC\uC694."
  - "\uD63C\uC790 \uC2A4\uB974\uB975 \uC0AC\uB77C\uC9C0\uB358\uB370\uC694? \uAD6C\uC2AC\uC774\uB791
    \uC5F4\uC1E0\uB9CC \uB0C5\uB450\uACE0."
  - "\uC18C\uBA78\uD588\uB2E4\uB294 \uB9D0\uC778\uAC00?!"
  - "\uC774\uB7F4 \uC218\uAC00\u22EF \uC2E0\uC774\uC2DC\uC5EC\u22EF\u22EF."
  - "\uB4DC\uB514\uC5B4 \uC774 \uB545\uC5D0 \uD3C9\uD654\uAC00 \uCC3E\uC544\uC628\uB2E8
    \uB9D0\uC785\uB2C8\uAE4C\u22EF\u22EF."
  - "\uADF8\uAC74 \uADF8\uB807\uACE0, \uD639\uC2DC \uC774 \uC5F4\uC1E0\uAC00 \uC774\uACF3\uC758
    \uAC83\uC778\uAC00?"
  - "\uC815\uB2F5\uC774\uC5C8\uB2E4."
  - "\uC544\uC544\u22EF \uACE0\uB9D9\uB124. \uC815\uB9D0 \uACE0\uB9C8\uC6CC."
  - "\uAD1C\uCC2E\uB2E4\uBA74 \uD568\uAED8 \uC655\uB3C4\uB85C \uB3CC\uC544\uAC00\uC9C0
    \uC54A\uACA0\uB098?"
  - "\uADF8\u22EF\u22EF \uC544\uB1E8, \uC804 \uC2AC\uC2AC \uC9D1\uC5D0 \uAC00\uACE0
    \uC2F6\uC740\uB370."
  - "\uB3CC\uC544\uAC00\uB294 \uBC29\uBC95\uC740 \uC54C\uACE0?"
  - "\u22EF\u22EF."
  - "\uD558\uD558, \uB108\uBB34 \uACE4\uB780\uD574\uD558\uC9C0 \uB9D0\uAC8C."
  - "\uC774\uB7F0 \uC801\uC740 \uCC98\uC74C\uC774\uB77C\u22EF \uB098\uB3C4 \uC798\uC740
    \uBAA8\uB974\uACA0\uC9C0\uB9CC,"
  - "\uC5B4\uCA4C\uBA74 \uC218\uC11D \uB9C8\uBC95\uC0AC\uC778 \uCC28\uB974\uB374\uC774
    \uB3CC\uC544\uC640 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC9C0\u22EF."
  - "\u22EF\u22EF. \uC5B4\uCA54 \uC218 \uC5C6\uB124\uC694. \uADF8\uB7F4\uAC8C\uC694,
    \uADF8\uB7FC."
