  - {fileID: 11400000, guid: 08ea6c376f9f34353be13fa5547d5d32, type: 2}
  paragraphs:
  - "\uC5B4\u22EF\u22EF. \uBB50\uC9C0? \uBD84\uC704\uAC00\uAC00 \uC5B4\uC218\uC120\uD55C\uB370."
  - "\u22EF\uC800\uAC74 \uBB50\uC57C? \uB3C4\uB9C8\uBC40?"
  - "\uB300\uCDA9 \uAC8C\uC784\uC5D0\uC11C \uB098\uC624\uB294 \uB9AC\uC790\uB4DC\uB9E8\uC774\uB791
    \uBE44\uC2B7\uD558\uAC8C \uC0DD\uACBC\uB124\u22EF\u22EF."
  - "\uD074\uB9AC\uC170\uB97C \uC0DD\uAC01\uD574 \uBCF4\uBA74\u22EF \uC7E4\uB4E4\uB3C4
    \uC801\uC774\uACA0\uC9C0?"
  - "\uCE68\uC785\uC790\uB2E4!!!"
  - "\uB204\uAD6C\uB0D0! \uAC10\uD788 \uC6B0\uB9AC \uB9AC\uC790\uB4DC\uB9E8\uC758
    \uB545\uC5D0 \uD568\uBD80\uB85C \uBC1C\uC744 \uB4E4\uC774\uB2E4\uB2C8, \uAC81\uC774
    \uC5C6\uAD70!"
  - "\uC608\uC0C1\uC744 \uBC97\uC5B4\uB098\uC9C8 \uC54A\uB124."
  - "\uC8C4\uC1A1\uD574\uC694. \uADF8\uB7F0 \uC904 \uBAB0\uB790\uC5B4\uC694. \uC774
    \uADFC\uCC98\uC5D0 \uCC98\uC74C \uC640\uBD24\uAC70\uB4E0\uC694\u22EF\u22EF."
  - "\uBCC0\uBA85\uC740 \uD544\uC694 \uC5C6\uB2E4. \uC774 \uB545\uC5D0 \uBC1C\uC744
    \uB51B\uC740 \uC774\uC0C1 \uD1B5\uD589\uB8CC\uB97C \uB0B4\uC57C \uD55C\uB2E4."
  - "\uC800 \uB3C8\uC774 \uD558\uB098\uB3C4 \uC5C6\uB294\uB370\u22EF\u22EF."
  - "\uADF8\uB807\uB2E4\uBA74 \uBAB8\uC73C\uB85C \uAC1A\uC544\uC57C\uC9C0!"
  - "\uC800\uAE30 \uC0C8\uB07C \uB9AC\uC790\uB4DC\uB9E8 \uB140\uC11D\uC774 \uC77C\uD558\uACE0
    \uC788\uB294 \uBC2D\uC73C\uB85C \uAC00\uB77C."
  - "\uC124\uB9C8\u22EF \uC5B4\uB9B0 \uB3D9\uC871\uC744 \uB178\uC608\uCC98\uB7FC
    \uBD80\uB9AC\uACE0 \uC788\uB294 \uAC74\uAC00?"
  - "\uC74C\u22EF \uADF8\uB807\uC9C0\uB9CC \uC81C\uAC00 \uAC08 \uAE38\uC774 \uBC14\uBE60\uC11C\uC694.
    \uB9C8\uC655\uC744 \uBB34\uCC0C\uB974\uB7EC \uAC00\uB294 \uC911\uC774\uB77C."
  - "\uD1B5\uD589\uB8CC\uB85C \uC774 \uC138\uACC4\uC758 \uD3C9\uD654\u22EF \uAC19\uC740
    \uAC78 \uAC00\uC838\uC624\uACA0\uB2E4\uACE0 \uD558\uBA74 \uC548 \uB418\uB294
    \uAC78\uAE4C\uC694? \uD558\uD558."
  - "\uBB50\u22EF \uBB50\uB77C!!! \uB124 \uC774\uB188!!!!!!"
  - "\uAC10\uD788 \uC704\uB300\uD558\uC2E0 \uADF8\uBD84\uC744 \uC4F0\uB7EC\uB728\uB9AC\uACA0\uB2E4\uACE0?
    \uD5C8\uD48D\uC774 \uC2EC\uD558\uAD70!"
  - "\uADF8\uB798\u22EF\u22EF. \uC544\uB2C8\uB098 \uB2E4\uB97C\uAE4C \uB9C8\uC655
    \uD3B8\uC774\uC5C8\uAD6C\uB098."
  - "\uD5C8\uD2BC \uACC4\uD68D\uC774\uB77C \uD55C\uB4E4, \uADF8 \uBD88\uC190\uD55C
    \uB9C8\uC74C\uAC00\uC9D0\uB9CC\uC73C\uB85C\uB3C4 \uC8C4\uAC00 \uB418\uB294 \uBC95."
  - "\uADF8\uAC78 \uC2A4\uC2A4\uB85C \uACE0\uBC31\uD558\uB2E4\uB2C8 \uBA4D\uCCAD\uD558\uAE30
    \uC9DD\uC774 \uC5C6\uAD6C\uB098."
  - "\uADF8\uBD84\uAED8 \uBC1B\uC740 \uD798\uC73C\uB85C \uC2EC\uD310\uD558\uB3C4\uB85D
    \uD558\uACA0\uB2E4."
